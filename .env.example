APP_NAME=AI Website Link Analysis API
APP_VERSION=1.0.0
APP_DESCRIPTION=An AI-powered FastAPI backend that accepts a website URL, extracts website content, and generates structured business, competitor, SEO, search query, service, and target audience insights.

REQUEST_TIMEOUT=15
MAX_CONTENT_LENGTH=15000
MAX_RESPONSE_BYTES=2097152
USER_AGENT=AIWebsiteLinkAnalysisBot/1.0

LLM_PROVIDER=gemini
# Primary fast, cost-effective Gemini model supporting structured JSON output.
# Documented fallback/alternative models (never switched silently at runtime):
#   gemini-3.6-flash (higher reasoning capacity)
#   gemini-2.5-flash-lite (legacy fast fallback)
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MODEL=
GEMINI_API_KEY=

LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=1.0
LLM_MAX_OUTPUT_TOKENS=4096
